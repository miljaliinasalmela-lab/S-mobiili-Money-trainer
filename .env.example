# GEMINI_API_KEY: Server-side API key for Google Gemini (@google/genai).
# Never expose this key in client-side code or commit real secrets to Git.
# If omitted or left as placeholder, the server automatically uses the transparent local deterministic fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Public URL when hosted in Cloud Run / AI Studio.
APP_URL="http://localhost:3000"
